{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/quiz/", "destination": "/index.html" },
    { "source": "/comparateur/", "destination": "/index.html" },
    { "source": "/regions/", "destination": "/index.html" },
    { "source": "/articles/", "destination": "/index.html" },
    { "source": "/mentions/", "destination": "/index.html" },
    { "source": "/rgpd/", "destination": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": true
}
