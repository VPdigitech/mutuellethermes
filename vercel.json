{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    { "source": "/articles/", "destination": "/", "permanent": false },
    { "source": "/articles", "destination": "/", "permanent": false },
    { "source": "/comparateur/", "destination": "/", "permanent": false },
    { "source": "/comparateur", "destination": "/", "permanent": false },
    { "source": "/quiz/", "destination": "/", "permanent": false },
    { "source": "/quiz", "destination": "/", "permanent": false },
    { "source": "/regions/", "destination": "/", "permanent": false },
    { "source": "/regions", "destination": "/", "permanent": false },
    { "source": "/mentions/", "destination": "/", "permanent": false },
    { "source": "/rgpd/", "destination": "/", "permanent": false }
  ],
  "cleanUrls": true,
  "trailingSlash": true
}
